{
  "manifest_version": 3,
  "name": "Gestor Avanzado de Acceso Web y Dispositivos",
  "version": "2.0",
  "description": "Control seguro de acceso web con listas blancas/negras, roles, auditoría y declarativeNetRequest.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Panel de Control"
  }
}
